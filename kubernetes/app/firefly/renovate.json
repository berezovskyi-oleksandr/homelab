{
  "kubernetes": {
    "fileMatch": ["kubernetes/app/firefly/.+\\.yaml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["kubernetes/app/firefly/release\\.yaml$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["kubernetes/app/firefly/**"],
      "semanticCommitScope": "k8s/firefly"
    },
    {
      "description": "Tags are version-X.Y.Z; skip floating version-X.Y, version-X, latest, develop",
      "matchFileNames": ["kubernetes/app/firefly/**"],
      "matchPackageNames": ["fireflyiii/core"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchFileNames": ["kubernetes/app/firefly/**"],
      "matchPackageNames": ["fireflyiii/core"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchFileNames": ["kubernetes/app/firefly/**"],
      "matchPackageNames": ["fireflyiii/core"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Ignore infrastructure images",
      "matchFileNames": ["kubernetes/app/firefly/**"],
      "matchPackageNames": ["postgres", "creativeprojects/resticprofile"],
      "enabled": false
    }
  ]
}
